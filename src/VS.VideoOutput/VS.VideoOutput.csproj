<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VITEC.SoccerVideoOutput</AssemblyName>
    <RootNamespace>VS.VideoOutput</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <AssemblyTitle>VITEC Soccer Scoreboard Video Output</AssemblyTitle>
    <Product>VITEC Soccer Scoreboard</Product>
    <Description>VITEC Soccer Scoreboard multicast and SRT video renderer</Description>
    <Version>0.2.5</Version>
    <AssemblyVersion>0.2.5.0</AssemblyVersion>
    <FileVersion>0.2.5.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="150.0.110" />
  </ItemGroup>
</Project>
