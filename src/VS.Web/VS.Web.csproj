<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VITEC.SoccerScoreboard</AssemblyName>
    <RootNamespace>VS.Web</RootNamespace>
    <Version>0.2.7</Version>
    <AssemblyVersion>0.2.7.0</AssemblyVersion>
    <FileVersion>0.2.7.0</FileVersion>
    <AssemblyTitle>VITEC Soccer Scoreboard Service</AssemblyTitle>
    <Product>VITEC Soccer Scoreboard</Product>
    <Description>VITEC Soccer Scoreboard live scoring and MatchCenter service</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VS.Core\VS.Core.csproj" />
    <ProjectReference Include="..\VS.MLB\VS.MLB.csproj" />
    <ProjectReference Include="..\VS.Soccer\VS.Soccer.csproj" />
    <ProjectReference Include="..\VS.Data\VS.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
  </ItemGroup>
</Project>
